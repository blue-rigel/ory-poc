# Ory Network project SDK URL, e.g. https://<project-slug>.projects.oryapis.com
NEXT_PUBLIC_ORY_SDK_URL=https://<project-slug>.projects.oryapis.com

# Same value, used server-side by @ory/nextjs config.
ORY_SDK_URL=https://<project-slug>.projects.oryapis.com

# OIDC issuer used by this portal's Auth.js configuration.
ORY_ISSUER=https://<project-slug>.projects.oryapis.com
AUTH_URL=https://orypoc.test
